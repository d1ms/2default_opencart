{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-hero" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-hero" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_image }}</label>
            <div class="col-sm-10">
              <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
              <input type="hidden" name="image" value="{{ image }}" id="input-image" />
              <div class="help-block">{{ help_image }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <br />
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane" id="language{{ language.language_id }}">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-eyebrow{{ language.language_id }}">{{ entry_eyebrow }}</label>
                <div class="col-sm-10">
                  <input type="text" name="hero_description[{{ language.language_id }}][eyebrow]" value="{{ hero_description[language.language_id].eyebrow }}" placeholder="{{ entry_eyebrow }}" id="input-eyebrow{{ language.language_id }}" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-title{{ language.language_id }}">{{ entry_title }}</label>
                <div class="col-sm-10">
                  <input type="text" name="hero_description[{{ language.language_id }}][title]" value="{{ hero_description[language.language_id].title }}" placeholder="{{ entry_title }}" id="input-title{{ language.language_id }}" class="form-control" />
                  {% if error_title[language.language_id] %}
                  <div class="text-danger">{{ error_title[language.language_id] }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                <div class="col-sm-10">
                  <textarea name="hero_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" rows="4" class="form-control">{{ hero_description[language.language_id].description }}</textarea>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-button-1-text{{ language.language_id }}">{{ entry_button_1_text }}</label>
                <div class="col-sm-4">
                  <input type="text" name="hero_description[{{ language.language_id }}][button_1_text]" value="{{ hero_description[language.language_id].button_1_text }}" placeholder="{{ entry_button_1_text }}" id="input-button-1-text{{ language.language_id }}" class="form-control" />
                </div>
                <label class="col-sm-2 control-label" for="input-button-1-link{{ language.language_id }}">{{ entry_button_1_link }}</label>
                <div class="col-sm-4">
                  <input type="text" name="hero_description[{{ language.language_id }}][button_1_link]" value="{{ hero_description[language.language_id].button_1_link }}" placeholder="{{ entry_button_1_link }}" id="input-button-1-link{{ language.language_id }}" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-button-2-text{{ language.language_id }}">{{ entry_button_2_text }}</label>
                <div class="col-sm-4">
                  <input type="text" name="hero_description[{{ language.language_id }}][button_2_text]" value="{{ hero_description[language.language_id].button_2_text }}" placeholder="{{ entry_button_2_text }}" id="input-button-2-text{{ language.language_id }}" class="form-control" />
                </div>
                <label class="col-sm-2 control-label" for="input-button-2-link{{ language.language_id }}">{{ entry_button_2_link }}</label>
                <div class="col-sm-4">
                  <input type="text" name="hero_description[{{ language.language_id }}][button_2_link]" value="{{ hero_description[language.language_id].button_2_link }}" placeholder="{{ entry_button_2_link }}" id="input-button-2-link{{ language.language_id }}" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <div class="col-sm-10 col-sm-offset-2">
                  <div class="help-block">{{ help_button }}</div>
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#language a:first').tab('show');
//--></script>
{{ footer }}
