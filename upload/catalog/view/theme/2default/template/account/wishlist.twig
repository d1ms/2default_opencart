{{ header }}
{% import '2default/template/common/icon.twig' as ic %}
<div id="account-wishlist" class="container-app py-8 md:py-12">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if success %}
  <div class="alert alert-success alert-dismissible">{{ ic.icon('check-circle', 'w-4 h-4 inline -mt-0.5') }} {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
  {% endif %}

  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}
      <h1 class="font-headline text-2xl md:text-3xl font-extrabold text-ink mb-6 flex items-center gap-2.5">
        {{ ic.icon('heart', 'w-7 h-7 text-danger fill-current') }} {{ heading_title }}
      </h1>

      {% if products %}
      <div class="space-y-3">
        {% for product in products %}
        <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center p-4 rounded-2xl bg-white border border-border/40 hover:border-primary/40 transition-all shadow-2xs">
          {% if product.thumb %}
          <a href="{{ product.href }}" class="shrink-0"><img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-20 h-20 object-contain rounded-xl bg-surface-2 p-1"></a>
          {% endif %}
          <div class="flex-1 min-w-0">
            <a href="{{ product.href }}" class="font-headline font-bold text-sm text-ink hover:text-primary no-underline transition-colors">{{ product.name }}</a>
            <div class="text-xs text-ink-3 mt-1 flex items-center gap-2">
              <span>{{ product.model }}</span>
              <span>&middot;</span>
              <span class="font-medium text-ink-2">{{ product.stock }}</span>
            </div>
          </div>
          <div class="text-right shrink-0 w-full sm:w-auto">
            {% if product.price %}
            {% if not product.special %}
            <div class="font-headline font-bold text-base text-primary">{{ product.price }}</div>
            {% else %}
            <div class="font-headline font-bold text-base text-primary">{{ product.special }} <span class="text-xs text-ink-3 line-through font-normal ml-1">{{ product.price }}</span></div>
            {% endif %}
            {% endif %}
          </div>
          <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end">
            <button type="button" onclick="cart.add('{{ product.product_id }}');" data-toggle="tooltip" title="{{ button_cart }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-accent hover:bg-primary text-white font-headline font-bold text-xs shadow-xs transition-all cursor-pointer border-0 no-underline">
              {{ ic.icon('shopping-cart', 'w-4 h-4') }} <span class="hidden sm:inline">{{ button_cart }}</span>
            </button>
            <a href="{{ product.remove }}" data-toggle="tooltip" title="{{ button_remove }}" class="w-9 h-9 rounded-full bg-surface-2 hover:bg-danger-soft text-ink-3 hover:text-danger flex items-center justify-center transition-colors no-underline">
              {{ ic.icon('trash', 'w-4 h-4') }}
            </a>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="text-center py-16 px-6 bg-white rounded-2xl border border-border/40 space-y-3 shadow-2xs">
        <div class="w-12 h-12 rounded-full bg-surface-2 flex items-center justify-center mx-auto text-ink-3">
          {{ ic.icon('heart', 'w-6 h-6 text-danger') }}
        </div>
        <p class="text-sm text-ink-2 font-medium">{{ text_empty }}</p>
      </div>
      {% endif %}

      <div class="flex justify-end mt-6">
        <a href="{{ continue }}" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-accent hover:bg-primary text-white font-headline font-bold text-sm shadow-sm transition-all no-underline">
          {{ button_continue }} {{ ic.icon('arrow-right', 'w-4 h-4') }}
        </a>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
