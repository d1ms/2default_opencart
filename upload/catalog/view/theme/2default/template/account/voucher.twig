{{ header }}
{% import '2default/template/common/icon.twig' as ic %}
<div id="account-voucher" class="container-app py-8 md:py-12">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible">{{ ic.icon('alert-circle', 'w-4 h-4 inline -mt-0.5') }} {{ error_warning }}</div>
  {% endif %}

  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}
      <h1 class="font-headline text-2xl md:text-3xl font-extrabold text-ink mb-2">{{ heading_title }}</h1>
      <p class="text-sm text-ink-2 mb-6">{{ text_description }}</p>

      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="space-y-4 max-w-3xl">
        <fieldset class="bg-white rounded-2xl border border-border/40 p-5 md:p-6">
          <div class="form-group required">
            <label class="control-label" for="input-to-name">{{ entry_to_name }}</label>
            <input type="text" name="to_name" value="{{ to_name }}" id="input-to-name" class="form-control" />
            {% if error_to_name %}
            <div class="text-danger">{{ error_to_name }}</div>
            {% endif %}
          </div>
          <div class="form-group required">
            <label class="control-label" for="input-to-email">{{ entry_to_email }}</label>
            <input type="text" name="to_email" value="{{ to_email }}" id="input-to-email" class="form-control" />
            {% if error_to_email %}
            <div class="text-danger">{{ error_to_email }}</div>
            {% endif %}
          </div>
          <div class="form-group required">
            <label class="control-label" for="input-from-name">{{ entry_from_name }}</label>
            <input type="text" name="from_name" value="{{ from_name }}" id="input-from-name" class="form-control" />
            {% if error_from_name %}
            <div class="text-danger">{{ error_from_name }}</div>
            {% endif %}
          </div>
          <div class="form-group required">
            <label class="control-label" for="input-from-email">{{ entry_from_email }}</label>
            <input type="text" name="from_email" value="{{ from_email }}" id="input-from-email" class="form-control" />
            {% if error_from_email %}
            <div class="text-danger">{{ error_from_email }}</div>
            {% endif %}
          </div>
          <div class="form-group required">
            <label class="control-label">{{ entry_theme }}</label>
            {% for voucher_theme in voucher_themes %}
            {% if voucher_theme.voucher_theme_id == voucher_theme_id %}
            <div class="radio">
              <label>
                <input type="radio" name="voucher_theme_id" value="{{ voucher_theme.voucher_theme_id }}" checked="checked" />
                {{ voucher_theme.name }}</label>
            </div>
            {% else %}
            <div class="radio">
              <label>
                <input type="radio" name="voucher_theme_id" value="{{ voucher_theme.voucher_theme_id }}" />
                {{ voucher_theme.name }}</label>
            </div>
            {% endif %}
            {% endfor %}
            {% if error_theme %}
            <div class="text-danger">{{ error_theme }}</div>
            {% endif %}
          </div>
          <div class="form-group">
            <label class="control-label" for="input-message">{{ entry_message }}</label>
            <textarea name="message" rows="5" id="input-message" class="form-control" data-toggle="tooltip" title="{{ help_message }}">{{ message }}</textarea>
          </div>
          <div class="form-group mb-0">
            <label class="control-label" for="input-amount">{{ entry_amount }}</label>
            <input type="text" name="amount" value="{{ amount }}" id="input-amount" class="form-control max-w-[10rem]" data-toggle="tooltip" title="{{ help_amount }}" />
            {% if error_amount %}
            <div class="text-danger">{{ error_amount }}</div>
            {% endif %}
          </div>
        </fieldset>

        <div class="flex flex-wrap items-center justify-end gap-3">
          <label class="flex items-center gap-2 text-sm text-ink-2 cursor-pointer">
            {% if agree %}
            <input type="checkbox" name="agree" value="1" checked="checked" />
            {% else %}
            <input type="checkbox" name="agree" value="1" />
            {% endif %}
            {{ text_agree }}
          </label>
          <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-accent hover:bg-primary text-white font-headline font-bold text-sm shadow-sm transition-all no-underline cursor-pointer"><span>{{ button_continue }}</span> {{ ic.icon('arrow-right', 'w-4 h-4') }}</button>
        </div>
      </form>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
