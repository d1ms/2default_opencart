{{ header }}
{% import '2default/template/common/icon.twig' as ic %}
<div id="product-compare" class="container-app py-6 md:py-12">

  <nav aria-label="Breadcrumb" class="flex text-xs font-semibold text-ink-3 mb-3">
    <ol class="inline-flex items-center flex-wrap gap-1">
      {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
      <li><a href="{{ breadcrumb.href }}" class="text-ink-3 hover:text-primary no-underline">{{ breadcrumb.text }}</a></li>
      <li><span class="mx-1 text-border">/</span></li>
      {% else %}
      <li><span class="text-primary font-bold">{{ breadcrumb.text }}</span></li>
      {% endif %}
      {% endfor %}
    </ol>
  </nav>

  {% if success %}
  <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg flex items-start gap-3">
    {{ ic.icon('check-circle', 'w-5 h-5 text-green-600 shrink-0 mt-0.5') }}
    <div class="flex-1">
      <p class="text-sm text-green-800">{{ success }}</p>
      <button type="button" class="mt-2 text-xs text-green-600 hover:text-green-700 font-semibold">{{ close|default('Dismiss') }}</button>
    </div>
  </div>
  {% endif %}

  <h1 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-8">{{ heading_title }}</h1>

  {% if products %}
  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b-2 border-primary">
              <th class="text-left p-4 font-semibold text-ink bg-surface-2">{{ text_product }}</th>
              {% for product in products %}
              <th class="text-center p-4 font-semibold text-ink bg-surface-2">
                <a href="{{ product.href }}" class="text-primary hover:text-primary/80 no-underline font-bold">{{ product.name }}</a>
              </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_image }}</td>
              {% for product in products %}
              <td class="text-center p-4">
                {% if product.thumb %}
                <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="w-24 h-24 object-cover rounded-lg mx-auto" />
                {% endif %}
              </td>
              {% endfor %}
            </tr>

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_price }}</td>
              {% for product in products %}
              <td class="text-center p-4">
                {% if product.price %}
                <div class="space-y-1">
                  {% if not product.special %}
                  <div class="text-lg font-bold text-primary">{{ product.price }}</div>
                  {% else %}
                  <div class="text-sm line-through text-ink-3">{{ product.price }}</div>
                  <div class="text-lg font-bold text-danger">{{ product.special }}</div>
                  {% endif %}
                </div>
                {% endif %}
              </td>
              {% endfor %}
            </tr>

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_model }}</td>
              {% for product in products %}
              <td class="text-center p-4 text-sm text-ink-2">{{ product.model }}</td>
              {% endfor %}
            </tr>

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_manufacturer }}</td>
              {% for product in products %}
              <td class="text-center p-4 text-sm text-ink-2">{{ product.manufacturer }}</td>
              {% endfor %}
            </tr>

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_availability }}</td>
              {% for product in products %}
              <td class="text-center p-4 text-sm">
                {% if product.availability %}
                <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">{{ product.availability }}</span>
                {% else %}
                <span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">{{ text_out_of_stock|default('Out of Stock') }}</span>
                {% endif %}
              </td>
              {% endfor %}
            </tr>

            {% if review_status %}
            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_rating }}</td>
              {% for product in products %}
              <td class="text-center p-4">
                <div class="flex items-center justify-center gap-1 mb-2">
                  {% for i in 1..5 %}
                  {% if product.rating >= i %}
                  {{ ic.icon('star', 'w-4 h-4 fill-yellow-400 text-yellow-400') }}
                  {% else %}
                  {{ ic.icon('star', 'w-4 h-4 text-gray-300') }}
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="text-xs text-ink-3">{{ product.reviews }} {{ text_reviews|default('reviews') }}</div>
              </td>
              {% endfor %}
            </tr>
            {% endif %}

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_summary }}</td>
              {% for product in products %}
              <td class="p-4 text-sm text-ink-2">{{ product.description|truncate(100) }}</td>
              {% endfor %}
            </tr>

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_weight }}</td>
              {% for product in products %}
              <td class="text-center p-4 text-sm text-ink-2">{{ product.weight }}</td>
              {% endfor %}
            </tr>

            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ text_dimension }}</td>
              {% for product in products %}
              <td class="text-center p-4 text-sm text-ink-2">{{ product.length }} × {{ product.width }} × {{ product.height }}</td>
              {% endfor %}
            </tr>

            {% for attribute_group in attribute_groups %}
            <tr>
              <td colspan="{{ products|length + 1 }}" class="p-4 bg-surface-2 font-semibold text-ink border-b border-border/40">{{ attribute_group.name }}</td>
            </tr>
            {% for key, attribute in attribute_group.attribute %}
            <tr class="border-b border-border/40 hover:bg-surface">
              <td class="p-4 font-semibold text-ink">{{ attribute.name }}</td>
              {% for product in products %}
              <td class="text-center p-4 text-sm text-ink-2">
                {% if product.attribute[key] %}
                {{ product.attribute[key] }}
                {% else %}
                <span class="text-gray-400">—</span>
                {% endif %}
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
            {% endfor %}

            <tr class="border-t-2 border-primary bg-surface-2">
              <td class="p-4"></td>
              {% for product in products %}
              <td class="p-4 space-y-2">
                <button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" class="w-full px-4 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold text-sm rounded-lg transition-colors flex items-center justify-center gap-2">
                  {{ ic.icon('shopping-cart', 'w-4 h-4') }}
                  {{ button_cart }}
                </button>
                <a href="{{ product.remove }}" class="block w-full px-4 py-2.5 bg-red-50 hover:bg-red-100 text-red-700 font-semibold text-sm rounded-lg transition-colors text-center no-underline">{{ button_remove }}</a>
              </td>
              {% endfor %}
            </tr>
          </tbody>
        </table>
      </div>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
  {% else %}
  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

      <div class="text-center py-20 bg-white rounded-2xl border border-border/40 p-8 space-y-4">
        <p class="text-sm text-ink-2">{{ text_empty }}</p>
        <a href="{{ continue }}" class="inline-block px-5 py-2.5 bg-accent hover:bg-primary text-white rounded-lg text-xs font-bold no-underline">{{ button_continue }}</a>
      </div>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
  {% endif %}
</div>
{{ footer }}
