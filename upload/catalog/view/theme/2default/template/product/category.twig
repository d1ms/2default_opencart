{{ header }}
{% import '2default/template/common/icon.twig' as ic %}
<div id="product-category" class="container-app py-6 md:py-12">

  <nav aria-label="Breadcrumb" class="flex text-xs font-semibold text-ink-3 mb-3">
    <ol class="inline-flex items-center flex-wrap gap-1">
      {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
      <li><a href="{{ breadcrumb.href }}" class="text-ink-3 hover:text-primary no-underline">{{ breadcrumb.text }}</a></li>
      <li><span class="mx-1 text-border">/</span></li>
      {% else %}
      <li><span class="text-primary font-bold">{{ breadcrumb.text }}</span></li>
      {% endif %}
      {% endfor %}
    </ol>
  </nav>

  <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4 meta-category-description">
        <div>
          <h1 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight">{{ heading_title }}</h1>
          {% if thumb or description %}
          <div class="mt-3 flex items-start gap-4">
            {% if thumb %}
            <img src="{{ thumb }}" alt="{{ heading_title }}" class="w-20 h-20 object-cover rounded-xl shrink-0">
            {% endif %}
            {% if description %}
            <div class="text-sm text-ink-2 leading-relaxed">{{ description|raw }}</div>
            {% endif %}
          </div>
          {% endif %}
        </div>
  </div>

  {% if categories or products %}
  <div class="product-specify-bar w-full mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    {% if categories %}
    <div class="flex items-center gap-3 flex-wrap">
      <span class="text-sm font-bold text-ink shrink-0">{{ text_subcategories|default('Subcategories:') }}</span>
      <div class="flex items-center gap-2 flex-wrap">
        <a href="{{ (breadcrumbs|last).href }}" class="category-pill category-pill-active">
          {{ text_all|default('All') }}
          {% if category_total is defined and category_total is not null %}
          <span class="category-pill-count">{{ category_total }}</span>
          {% endif %}
        </a>
        {% for category in categories %}
        <a href="{{ category.href }}" class="category-pill">
          {{ category.name }}
          {% if category.count is defined and category.count is not null %}
          <span class="category-pill-count">{{ category.count }}</span>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if products %}
    <div class="relative shrink-0 {% if not categories %}md:ml-auto{% endif %}">
      <select id="product-sorting-box" class="appearance-none font-semibold text-xs md:text-sm text-ink bg-white border border-border rounded-lg pl-4 pr-8 py-2.5 hover:border-primary transition-colors cursor-pointer" onchange="location = this.value;">
        {% for s in sorts %}
        {% if s.value == '%s-%s'|format(sort, order) %}
        <option value="{{ s.href }}" selected="selected">{{ s.text }}</option>
        {% else %}
        <option value="{{ s.href }}">{{ s.text }}</option>
        {% endif %}
        {% endfor %}
      </select>
      {{ ic.icon('chevron-down', 'w-3.5 h-3.5 text-muted absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none') }}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

    
      {% if products %}
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        {% for product in products %}
        {% include '2default/template/common/product_thumb.twig' with {'product': product} %}
        {% endfor %}
      </div>

      <div class="mt-14 flex items-center justify-between flex-wrap gap-4">
        <span class="text-xs text-ink-3">{{ results }}</span>
        <div class="pagination-app">{{ pagination|raw }}</div>
      </div>
      {% endif %}

      {% if not categories and not products %}
      <div class="text-center py-20 bg-white rounded-2xl border border-border/40 p-8 space-y-4">
        <p class="text-sm text-ink-2">{{ text_empty }}</p>
        <a href="{{ continue }}" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-accent hover:bg-primary text-white font-headline font-bold text-sm shadow-sm transition-all no-underline cursor-pointer">{{ button_continue }} {{ ic.icon('arrow-right', 'w-4 h-4') }}</a>
      </div>
      {% endif %}

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
