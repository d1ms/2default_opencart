{#
  SVG icon macro (lucide-static, ISC licensed) replacing Font Awesome glyphs
  throughout 2default. Usage:
    {% import '2default/template/common/icon.twig' as ic %}
    {{ ic.icon('heart', 'w-5 h-5') }}
    {{ ic.icon('heart', 'w-5 h-5 fill-current') }}  {# solid/filled variant #}
  Available names: menu, x, search, user, heart, shopping-bag, shopping-cart,
  chevron-down, chevron-left, chevron-right, star, minus, plus, trash,
  refresh, upload, calendar, check-circle, alert-circle, x-circle, info,
  repeat, arrow-right, arrow-left, ruler, sliders-horizontal, sparkles, zap,
  droplets, shield-check, more-horizontal, triangle-alert, eye,
  message-square, send, map-pin, phone, clock, printer, mail, external-link,
  folder, file-text, download, history, pencil.
  The list is generated by build/make_icon_sprite.js — add the name there
  first, re-run it, then use it here.
#}
{#
  fill/stroke are set on the outer <svg> (the consuming document), not just
  the <symbol> inside icons.svg. This is a *cross-file* <use href="...svg#id">
  reference (as opposed to a same-document "#id" reference) — for these,
  browsers do not reliably apply the symbol's own presentation attributes,
  so the sprite renders solid black unless the using element sets them
  itself. `fill-current` on the class param (for filled states like an
  active wishlist heart) overrides the base fill="none" as expected since
  it's a plain CSS property either way.
#}
{% macro icon(name, class) %}<svg class="{{ class|default('w-5 h-5') }} shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="catalog/view/theme/2default/js/icons.svg#icon-{{ name }}"></use></svg>{% endmacro %}
