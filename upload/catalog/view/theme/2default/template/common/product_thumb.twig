{#
  Shared product card, included wherever a product tile is rendered
  (category grid, related products, search results, featured/latest/
  bestseller/special modules). Include with:
    {% include '2default/template/common/product_thumb.twig' with {'product': product} %}
  `product` must have: product_id, href, thumb, name, price, special, tax,
  rating, minimum, and optionally description.
#}
{% import '2default/template/common/icon.twig' as ic %}
<div class="product-thumb-card group relative card-hover-effect rounded-2xl overflow-hidden bg-white p-2.5 border border-transparent hover:border-border/50 flex flex-col h-full shadow-2xs">

  <div class="relative w-full aspect-square bg-surface-2 rounded-xl overflow-hidden mb-3 p-4 flex items-center justify-center">
    <a href="{{ product.href }}" class="absolute inset-0" aria-label="{{ product.name }}"></a>
    <img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 ease-out pointer-events-none">

    <button type="button" onclick="wishlist.add('{{ product.product_id }}'); return false;" title="{{ text_wishlist|default('Wishlist') }}" class="absolute top-3 right-3 z-10 w-8 h-8 rounded-full flex items-center justify-center bg-white/80 backdrop-blur-md text-icon hover:text-danger hover:bg-white shadow-xs transition-colors">
      {{ ic.icon('heart', 'w-4 h-4') }}
    </button>

    {% if product.special %}
    <div class="absolute bottom-3 left-3 z-10">
      <span class="px-2.5 py-1 bg-danger text-white font-bold text-[11px] rounded-md shadow-2xs">{{ text_sale|default('Sale') }}</span>
    </div>
    {% endif %}
  </div>

  <div class="flex flex-col flex-grow px-2 pb-2">
    <a href="{{ product.href }}" class="no-underline">
      <h3 class="font-headline font-bold text-base text-ink mb-0.5 group-hover:text-primary transition-colors line-clamp-1">{{ product.name }}</h3>
    </a>
    {% if product.description %}
    <p class="text-xs text-ink-2 mb-3 flex-grow line-clamp-1">{{ product.description }}</p>
    {% endif %}

    {% if product.rating is defined and product.rating > 0 %}
    <div class="flex items-center gap-0.5 mb-2" aria-hidden="true">
      {% for i in 1..5 %}
      {{ ic.icon('star', 'w-3 h-3 ' ~ (i <= product.rating ? 'text-accent fill-current' : 'text-border')) }}
      {% endfor %}
    </div>
    {% endif %}

    <div class="flex items-center justify-between mt-auto pt-2 border-t border-surface-2">
      <span class="font-headline font-bold text-base text-primary">
        {% if product.special %}
        {{ product.special }} <span class="text-xs text-muted line-through font-normal">{{ product.price }}</span>
        {% else %}
        {{ product.price }}
        {% endif %}
      </span>
      <button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum is defined ? product.minimum : 1 }}'); return false;" class="p-2.5 rounded-full bg-accent/10 text-accent hover:bg-accent hover:text-white transition-all shadow-2xs active:scale-95" title="{{ button_cart|default('Add to Cart') }}">
        {{ ic.icon('shopping-bag', 'w-4 h-4') }}
      </button>
    </div>
  </div>
</div>
