{#
  Shared blog-article card, included wherever an article tile is rendered
  (featured_article module, blog article's own "related articles" list).
  Include with:
    {% include '2default/template/common/article_thumb.twig' with {'article': article} %}
  `article` must have: href, thumb, name, viewed, date_added, and
  optionally description, rating. `button_more` and `text_views` must be
  in scope (both are stock language strings already loaded by every
  controller that renders this partial).
#}
{% import '2default/template/common/icon.twig' as ic %}
<div class="group relative card-hover-effect rounded-2xl overflow-hidden bg-white border border-transparent hover:border-border/50 flex flex-col h-full shadow-2xs">

  <div class="relative w-full aspect-video bg-surface-2 overflow-hidden">
    <a href="{{ article.href }}" class="absolute inset-0 z-10" aria-label="{{ article.name }}"></a>
    <img src="{{ article.thumb }}" alt="{{ article.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out">
  </div>

  <div class="flex flex-col flex-grow p-4">
    <a href="{{ article.href }}" class="no-underline">
      <h4 class="font-headline font-bold text-base text-ink mb-1.5 group-hover:text-primary transition-colors line-clamp-2">{{ article.name }}</h4>
    </a>
    {% if article.description %}
    <p class="text-xs text-ink-2 mb-3 flex-grow line-clamp-2">{{ article.description }}</p>
    {% endif %}

    {% if article.rating %}
    <div class="flex items-center gap-0.5 mb-3" aria-hidden="true">
      {% for i in 1..5 %}
      {{ ic.icon('star', 'w-3 h-3 ' ~ (i <= article.rating ? 'text-accent fill-current' : 'text-border')) }}
      {% endfor %}
    </div>
    {% endif %}

    <div class="flex items-center justify-between gap-3 mt-auto pt-3 border-t border-surface-2 text-[11px] text-ink-3 font-semibold">
      <span class="inline-flex items-center gap-1 truncate" aria-label="{{ article.date_added }}">
        {{ ic.icon('calendar', 'w-3.5 h-3.5 shrink-0') }} <span class="truncate">{{ article.date_added }}</span>
      </span>
      <span class="inline-flex items-center gap-1 shrink-0" aria-label="{{ text_views }} {{ article.viewed }}">
        {{ ic.icon('eye', 'w-3.5 h-3.5') }} {{ article.viewed }}
      </span>
    </div>

    <a href="{{ article.href }}" class="relative z-10 mt-3 inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-full bg-accent/10 text-accent hover:bg-accent hover:text-white transition-all text-xs font-bold no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
      {{ button_more }} {{ ic.icon('arrow-right', 'w-3.5 h-3.5') }}
    </a>
  </div>
</div>
