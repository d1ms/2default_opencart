{% if products %}
<div class="container-app py-8 md:py-12">
  <h2 class="font-headline text-2xl md:text-3xl font-bold text-ink mb-6">{{ heading_title }}</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for product in products %}
    {% include '2default/template/common/product_thumb.twig' with {'product': product} %}
    {% endfor %}
  </div>
</div>
{% endif %}
