{% if categories %}
<div class="bg-white rounded-2xl border border-border/40 p-5 mb-6">
  <h3 class="font-headline text-sm font-bold text-ink uppercase tracking-wide pb-3 mb-3 border-b border-border/40">{{ heading_title|default('Categories') }}</h3>
  <ul class="flex flex-col gap-0.5">
    {% for category in categories %}
    <li>
      {% if category.category_id == category_id %}
      <a href="{{ category.href }}" class="flex items-center justify-between gap-2 rounded-lg px-3 py-2.5 text-sm font-bold bg-primary/10 text-primary no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <span class="truncate">{{ category.name }}</span>
        {% if category.count is not null %}
        <span class="shrink-0 inline-flex items-center justify-center min-w-[1.5rem] h-6 px-1.5 rounded-full bg-primary/15 text-primary text-xs font-bold">{{ category.count }}</span>
        {% endif %}
      </a>
      {% if category.children %}
      <ul class="mt-0.5 ml-3 pl-3 border-l border-border/60 flex flex-col gap-0.5">
        {% for child in category.children %}
        <li>
          {% if child.category_id == child_id %}
          <a href="{{ child.href }}" class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-bold bg-primary/10 text-primary no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          {% else %}
          <a href="{{ child.href }}" class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm text-ink-2 hover:bg-surface-3 hover:text-primary no-underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          {% endif %}
            <span class="truncate">{{ child.name }}</span>
            {% if child.count is not null %}
            <span class="shrink-0 inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1.5 rounded-full bg-surface-3 text-ink-3 text-xs font-semibold">{{ child.count }}</span>
            {% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      {% else %}
      <a href="{{ category.href }}" class="flex items-center justify-between gap-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-ink-2 hover:bg-surface-3 hover:text-primary no-underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <span class="truncate">{{ category.name }}</span>
        {% if category.count is not null %}
        <span class="shrink-0 inline-flex items-center justify-center min-w-[1.5rem] h-6 px-1.5 rounded-full bg-surface-3 text-ink-3 text-xs font-bold">{{ category.count }}</span>
        {% endif %}
      </a>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
