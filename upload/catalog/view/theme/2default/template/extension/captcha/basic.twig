<fieldset class="bg-white rounded-2xl border border-border/40 p-6 md:p-8 space-y-6">
  <legend class="font-headline text-lg font-bold text-ink pb-3 mb-6 border-b border-border/40 w-full block">{{ text_captcha }}</legend>
  <div class="form-group required">
    {% if route|slice(0, 9) == 'checkout/' %}
    <label class="control-label block text-sm font-semibold text-ink mb-2" for="input-payment-captcha">{{ entry_captcha }}</label>
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <input type="text" name="captcha" id="input-payment-captcha" class="form-control max-w-xs" autocomplete="off" />
      <img src="index.php?route=extension/captcha/basic/captcha" alt="captcha" class="rounded-lg border border-border/40" />
    </div>
    {% else %}
    <label class="control-label block text-sm font-semibold text-ink mb-2" for="input-captcha">{{ entry_captcha }}</label>
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <input type="text" name="captcha" id="input-captcha" class="form-control max-w-xs" />
      <img src="index.php?route=extension/captcha/basic/captcha" alt="captcha" class="rounded-lg border border-border/40" />
    </div>
    {% if error_captcha %}
    <div class="text-danger text-xs font-semibold mt-1">{{ error_captcha }}</div>
    {% endif %}
    {% endif %}
  </div>
</fieldset>
