{{ header }}
{% import '2default/template/common/icon.twig' as ic %}

{# Yandex map widget URL built from OpenCart's config_geocode. That field is
   conventionally "latitude,longitude" (it is fed to Google Maps' ?q=), but
   Yandex expects longitude,latitude in ll/pt — hence the swap. When the field
   holds a plain address instead of a coordinate pair we fall back to Yandex's
   text search, which still drops a pin. No API key is needed for map-widget. #}
{% set geo = geocode|trim %}
{% if geo matches '/^-?[0-9.]+ *, *-?[0-9.]+$/' %}
  {% set geo_parts = geo|split(',') %}
  {% set geo_lat = geo_parts[0]|trim %}
  {% set geo_lon = geo_parts[1]|trim %}
  {% set map_point = 'll=' ~ geo_lon ~ '%2C' ~ geo_lat ~ '&z=16&pt=' ~ geo_lon ~ '%2C' ~ geo_lat ~ '%2Cpm2rdm' %}
{% else %}
  {% set map_point = 'text=' ~ geo|url_encode ~ '&z=16' %}
{% endif %}

<div id="information-contact" class="container-app py-6 md:py-12">

  <nav aria-label="Breadcrumb" class="flex text-xs font-semibold text-ink-3 mb-3">
    <ol class="inline-flex items-center flex-wrap gap-1">
      {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
      <li><a href="{{ breadcrumb.href }}" class="text-ink-3 hover:text-primary no-underline">{{ breadcrumb.text }}</a></li>
      <li><span class="mx-1 text-border">/</span></li>
      {% else %}
      <li><span class="text-primary font-bold">{{ breadcrumb.text }}</span></li>
      {% endif %}
      {% endfor %}
    </ol>
  </nav>

  <h1 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-8">{{ heading_title }}</h1>

  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

      <section class="mb-12">
        <h2 class="font-headline text-xl sm:text-2xl font-bold text-ink mb-6 pb-4 border-b border-border/40">{{ text_location }}</h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

          <div class="space-y-4">
            <div class="rounded-2xl border border-border/40 bg-white p-5 md:p-6">
              <div class="flex items-start gap-4">
                {% if image %}
                <img src="{{ image }}" alt="{{ store }}" title="{{ store }}" class="w-20 h-20 object-cover rounded-xl shrink-0">
                {% endif %}
                <div class="min-w-0">
                  <p class="font-headline text-base font-bold text-ink mb-1">{{ store }}</p>
                  <div class="flex items-start gap-2 text-sm text-ink-2 leading-relaxed">
                    {{ ic.icon('map-pin', 'w-4 h-4 text-icon mt-0.5') }}
                    <address class="not-italic m-0">{{ address }}</address>
                  </div>
                  {% if geocode %}
                  <a href="https://yandex.ru/maps/?{{ map_point }}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-accent no-underline">
                    {{ ic.icon('external-link', 'w-3.5 h-3.5') }} {{ button_map }}
                  </a>
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-xl border border-border/40 bg-surface-2 p-4">
                <div class="flex items-start gap-2.5">
                  {{ ic.icon('phone', 'w-4 h-4 text-primary mt-0.5') }}
                  <div class="min-w-0">
                    <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_telephone }}</p>
                    <p class="text-sm font-bold text-ink break-words m-0">{{ telephone }}</p>
                  </div>
                </div>
              </div>

              {% if fax %}
              <div class="rounded-xl border border-border/40 bg-surface-2 p-4">
                <div class="flex items-start gap-2.5">
                  {{ ic.icon('printer', 'w-4 h-4 text-primary mt-0.5') }}
                  <div class="min-w-0">
                    <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_fax }}</p>
                    <p class="text-sm font-bold text-ink break-words m-0">{{ fax }}</p>
                  </div>
                </div>
              </div>
              {% endif %}

              {% if open %}
              <div class="rounded-xl border border-border/40 bg-surface-2 p-4">
                <div class="flex items-start gap-2.5">
                  {{ ic.icon('clock', 'w-4 h-4 text-primary mt-0.5') }}
                  <div class="min-w-0">
                    <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_open }}</p>
                    <div class="text-sm text-ink leading-relaxed">{{ open }}</div>
                  </div>
                </div>
              </div>
              {% endif %}

              {% if comment %}
              <div class="rounded-xl border border-border/40 bg-surface-2 p-4">
                <div class="flex items-start gap-2.5">
                  {{ ic.icon('info', 'w-4 h-4 text-primary mt-0.5') }}
                  <div class="min-w-0">
                    <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_comment }}</p>
                    <div class="text-sm text-ink leading-relaxed">{{ comment }}</div>
                  </div>
                </div>
              </div>
              {% endif %}
            </div>
          </div>

          {% if geocode %}
          <div class="rounded-2xl border border-border/40 overflow-hidden bg-surface-2">
            <iframe src="https://yandex.ru/map-widget/v1/?{{ map_point }}"
                    title="{{ store }} — {{ text_location }}"
                    class="block w-full h-[320px] lg:h-[440px] border-0"
                    loading="lazy"
                    allowfullscreen></iframe>
          </div>
          {% endif %}
        </div>
      </section>

      {% if locations %}
      <section class="mb-12">
        <h2 class="font-headline text-xl sm:text-2xl font-bold text-ink mb-6 pb-4 border-b border-border/40">{{ text_store }}</h2>

        <div class="space-y-3" id="contact-locations">
          {% for location in locations %}
          <div class="rounded-xl border border-border/40 bg-white overflow-hidden">
            <button type="button"
                    class="location-trigger w-full px-5 py-4 flex items-center justify-between gap-3 text-left font-bold text-ink hover:bg-surface-2 transition-colors"
                    aria-expanded="false"
                    aria-controls="collapse-location{{ location.location_id }}">
              <span class="flex items-center gap-2.5 min-w-0">
                {{ ic.icon('map-pin', 'w-4 h-4 text-primary') }}
                <span class="truncate">{{ location.name }}</span>
              </span>
              {{ ic.icon('chevron-down', 'location-chevron w-4 h-4 text-icon transition-transform') }}
            </button>

            <div id="collapse-location{{ location.location_id }}" class="location-panel hidden border-t border-border/40 p-5">
              <div class="flex flex-col sm:flex-row items-start gap-4 mb-4">
                {% if location.image %}
                <img src="{{ location.image }}" alt="{{ location.name }}" title="{{ location.name }}" class="w-24 h-24 object-cover rounded-xl shrink-0">
                {% endif %}
                <div class="min-w-0">
                  <div class="flex items-start gap-2 text-sm text-ink-2 leading-relaxed">
                    {{ ic.icon('map-pin', 'w-4 h-4 text-icon mt-0.5') }}
                    <address class="not-italic m-0">{{ location.address }}</address>
                  </div>
                  {% if location.geocode %}
                  <a href="https://yandex.ru/maps/?text={{ location.geocode|url_encode }}&z=16" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-accent no-underline">
                    {{ ic.icon('external-link', 'w-3.5 h-3.5') }} {{ button_map }}
                  </a>
                  {% endif %}
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="rounded-lg bg-surface-2 p-3">
                  <div class="flex items-start gap-2.5">
                    {{ ic.icon('phone', 'w-4 h-4 text-primary mt-0.5') }}
                    <div class="min-w-0">
                      <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_telephone }}</p>
                      <p class="text-sm font-bold text-ink break-words m-0">{{ location.telephone }}</p>
                    </div>
                  </div>
                </div>

                {% if location.fax %}
                <div class="rounded-lg bg-surface-2 p-3">
                  <div class="flex items-start gap-2.5">
                    {{ ic.icon('printer', 'w-4 h-4 text-primary mt-0.5') }}
                    <div class="min-w-0">
                      <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_fax }}</p>
                      <p class="text-sm font-bold text-ink break-words m-0">{{ location.fax }}</p>
                    </div>
                  </div>
                </div>
                {% endif %}

                {% if location.open %}
                <div class="rounded-lg bg-surface-2 p-3">
                  <div class="flex items-start gap-2.5">
                    {{ ic.icon('clock', 'w-4 h-4 text-primary mt-0.5') }}
                    <div class="min-w-0">
                      <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_open }}</p>
                      <div class="text-sm text-ink leading-relaxed">{{ location.open }}</div>
                    </div>
                  </div>
                </div>
                {% endif %}

                {% if location.comment %}
                <div class="rounded-lg bg-surface-2 p-3">
                  <div class="flex items-start gap-2.5">
                    {{ ic.icon('info', 'w-4 h-4 text-primary mt-0.5') }}
                    <div class="min-w-0">
                      <p class="text-[11px] font-bold text-ink-3 uppercase tracking-wide mb-0.5">{{ text_comment }}</p>
                      <div class="text-sm text-ink leading-relaxed">{{ location.comment }}</div>
                    </div>
                  </div>
                </div>
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <section class="mb-8">
        <h2 class="font-headline text-xl sm:text-2xl font-bold text-ink mb-6 pb-4 border-b border-border/40">{{ text_contact }}</h2>

        {% if error_agree %}
        <div class="alert alert-danger flex items-start gap-2">
          {{ ic.icon('triangle-alert', 'w-4 h-4 mt-0.5') }} <span>{{ error_agree }}</span>
        </div>
        {% endif %}

        <div class="rounded-2xl border border-border/40 bg-white p-5 md:p-6">
          <form action="{{ action }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-5">

            <div class="form-group required">
              <label class="control-label !p-0 !mb-2 block" for="input-name">{{ entry_name }}</label>
              <div class="relative">
                {{ ic.icon('user', 'w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-icon pointer-events-none') }}
                <input type="text" name="name" value="{{ name }}" id="input-name" placeholder="{{ entry_name }}" autocomplete="name" class="form-control !pl-10">
              </div>
              {% if error_name %}
              <div class="text-danger flex items-start gap-1.5 mt-1.5">
                {{ ic.icon('alert-circle', 'w-3.5 h-3.5 mt-0.5') }} <span>{{ error_name }}</span>
              </div>
              {% endif %}
            </div>

            <div class="form-group required">
              <label class="control-label !p-0 !mb-2 block" for="input-email">{{ entry_email }}</label>
              <div class="relative">
                {{ ic.icon('mail', 'w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-icon pointer-events-none') }}
                <input type="email" name="email" value="{{ email }}" id="input-email" placeholder="{{ entry_email }}" autocomplete="email" class="form-control !pl-10">
              </div>
              {% if error_email %}
              <div class="text-danger flex items-start gap-1.5 mt-1.5">
                {{ ic.icon('alert-circle', 'w-3.5 h-3.5 mt-0.5') }} <span>{{ error_email }}</span>
              </div>
              {% endif %}
            </div>

            <div class="form-group required">
              <label class="control-label !p-0 !mb-2 block" for="input-enquiry">{{ entry_enquiry }}</label>
              <div class="relative">
                {{ ic.icon('message-square', 'w-4 h-4 absolute left-3.5 top-3.5 text-icon pointer-events-none') }}
                <textarea name="enquiry" rows="8" id="input-enquiry" placeholder="{{ entry_enquiry }}" class="form-control !pl-10">{{ enquiry }}</textarea>
              </div>
              {% if error_enquiry %}
              <div class="text-danger flex items-start gap-1.5 mt-1.5">
                {{ ic.icon('alert-circle', 'w-3.5 h-3.5 mt-0.5') }} <span>{{ error_enquiry }}</span>
              </div>
              {% endif %}
            </div>

            {{ captcha }}

            <div class="flex items-center justify-end gap-4 flex-wrap pt-4 border-t border-border/40">
              {% if text_agree %}
              <label class="flex items-center gap-2 text-sm text-ink-2 mr-auto">
                {% if agree %}
                <input type="checkbox" name="agree" value="1" checked="checked">
                {% else %}
                <input type="checkbox" name="agree" value="1">
                {% endif %}
                {{ text_agree }}
              </label>
              {% endif %}
              <button type="submit" class="btn btn-outline-primary flex items-center gap-2">{{ ic.icon('send', 'w-4 h-4') }} {{ button_submit }}</button>
            </div>
          </form>
        </div>
      </section>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

<script type="text/javascript"><!--
$('#contact-locations').on('click', '.location-trigger', function () {
	var $trigger = $(this);
	var expanded = $trigger.attr('aria-expanded') === 'true';

	$trigger.attr('aria-expanded', expanded ? 'false' : 'true');
	$trigger.next('.location-panel').toggleClass('hidden', expanded);
	$trigger.find('.location-chevron').toggleClass('rotate-180', !expanded);
});
--></script>
{{ footer }}
