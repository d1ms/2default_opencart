{{ header }}
{% import '2default/template/common/icon.twig' as ic %}
<div id="information-sitemap" class="container-app py-6 md:py-12">

  <nav aria-label="Breadcrumb" class="flex text-xs font-semibold text-ink-3 mb-3">
    <ol class="inline-flex items-center flex-wrap gap-1">
      {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
      <li><a href="{{ breadcrumb.href }}" class="hover:text-primary no-underline">{{ breadcrumb.text }}</a></li>
      <li><span class="mx-1 text-border">/</span></li>
      {% else %}
      <li><span class="text-primary font-bold">{{ breadcrumb.text }}</span></li>
      {% endif %}
      {% endfor %}
    </ol>
  </nav>

  <h1 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-8">{{ heading_title }}</h1>

  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

        <div class="rounded-2xl border border-border/40 bg-white p-5 md:p-6">
          <ul class="list-none p-0 m-0 space-y-3">
            {% for category_1 in categories %}
            <li>
              <a href="{{ category_1.href }}" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-primary no-underline">
                {{ ic.icon('folder', 'w-4 h-4 text-primary') }} {{ category_1.name }}
              </a>
              {% if category_1.children %}
              <ul class="list-none mt-2 ml-2 pl-4 border-l border-border/60 space-y-1.5">
                {% for category_2 in category_1.children %}
                <li>
                  <a href="{{ category_2.href }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ category_2.name }}</a>
                  {% if category_2.children %}
                  <ul class="list-none mt-1.5 ml-1 pl-4 border-l border-border/40 space-y-1">
                    {% for category_3 in category_2.children %}
                    <li><a href="{{ category_3.href }}" class="text-xs text-ink-3 hover:text-primary no-underline">{{ category_3.name }}</a></li>
                    {% endfor %}
                  </ul>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="rounded-2xl border border-border/40 bg-white p-5 md:p-6">
          <ul class="list-none p-0 m-0 space-y-3">
            <li>
              <a href="{{ special }}" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-primary no-underline">
                {{ ic.icon('sparkles', 'w-4 h-4 text-primary') }} {{ text_special }}
              </a>
            </li>

            <li>
              <a href="{{ account }}" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-primary no-underline">
                {{ ic.icon('user', 'w-4 h-4 text-primary') }} {{ text_account }}
              </a>
              <ul class="list-none mt-2 ml-2 pl-4 border-l border-border/60 space-y-1.5">
                <li><a href="{{ edit }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ text_edit }}</a></li>
                <li><a href="{{ password }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ text_password }}</a></li>
                <li><a href="{{ address }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ text_address }}</a></li>
                <li><a href="{{ history }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ text_history }}</a></li>
                <li><a href="{{ download }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ text_download }}</a></li>
              </ul>
            </li>

            <li>
              <a href="{{ cart }}" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-primary no-underline">
                {{ ic.icon('shopping-cart', 'w-4 h-4 text-primary') }} {{ text_cart }}
              </a>
            </li>

            <li>
              <a href="{{ checkout }}" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-primary no-underline">
                {{ ic.icon('shopping-bag', 'w-4 h-4 text-primary') }} {{ text_checkout }}
              </a>
            </li>

            <li>
              <a href="{{ search }}" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-primary no-underline">
                {{ ic.icon('search', 'w-4 h-4 text-primary') }} {{ text_search }}
              </a>
            </li>

            <li>
              <span class="inline-flex items-center gap-2 text-sm font-bold text-ink">
                {{ ic.icon('file-text', 'w-4 h-4 text-primary') }} {{ text_information }}
              </span>
              <ul class="list-none mt-2 ml-2 pl-4 border-l border-border/60 space-y-1.5">
                {% for information in informations %}
                <li><a href="{{ information.href }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ information.title }}</a></li>
                {% endfor %}
                <li><a href="{{ contact }}" class="text-sm text-ink-2 hover:text-primary no-underline">{{ text_contact }}</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
