{% import '2default/template/common/icon.twig' as ic %}
<div class="bg-white rounded-2xl border border-border/40 p-5">
  {% if error_warning %}
  <div class="alert alert-warning alert-dismissible">{{ ic.icon('alert-circle', 'w-4 h-4 inline -mt-0.5') }} {{ error_warning }}</div>
  {% endif %}
  {% if payment_methods %}
  <p class="text-sm text-ink-2 mb-3">{{ text_payment_method }}</p>
  {% for payment_method in payment_methods %}
  <div class="radio">
    <label>{% if payment_method.code == code or not code %}
      {% set code = payment_method.code %}
      <input type="radio" name="payment_method" value="{{ payment_method.code }}" checked="checked" />
      {% else %}
      <input type="radio" name="payment_method" value="{{ payment_method.code }}" />
      {% endif %}
      {{ payment_method.title }}
      {% if payment_method.terms %}
      ({{ payment_method.terms }})
      {% endif %} </label>
  </div>
  {% endfor %}
  {% endif %}
  <p class="font-headline font-bold text-sm text-ink mt-4 mb-2">{{ text_comments }}</p>
  <p>
    <textarea name="comment" rows="6" class="form-control">{{ comment }}</textarea>
  </p>
  {% if text_agree %}
  <div class="buttons flex flex-wrap items-center justify-end gap-3 mt-4">
    <label class="flex items-center gap-2 text-sm text-ink-2 cursor-pointer">
      {% if agree %}
      <input type="checkbox" name="agree" value="1" checked="checked" />
      {% else %}
      <input type="checkbox" name="agree" value="1" />
      {% endif %}
      {{ text_agree }}
    </label>
    <input type="button" value="{{ button_continue }}" id="button-payment-method" data-loading-text="{{ text_loading }}" class="btn btn-primary" />
  </div>
  {% else %}
  <div class="buttons">
    <div class="pull-right">
      <input type="button" value="{{ button_continue }}" id="button-payment-method" data-loading-text="{{ text_loading }}" class="btn btn-primary" />
    </div>
  </div>
  {% endif %}
</div>
