{% import '2default/template/common/icon.twig' as ic %}
<div class="bg-white rounded-2xl border border-border/40 p-5">
  {% if error_warning %}
  <div class="alert alert-warning alert-dismissible">{{ ic.icon('alert-circle', 'w-4 h-4 inline -mt-0.5') }} {{ error_warning }}</div>
  {% endif %}
  {% if shipping_methods %}
  <p class="text-sm text-ink-2 mb-3">{{ text_shipping_method }}</p>
  {% for shipping_method in shipping_methods %}
  <p class="font-headline font-bold text-sm text-ink mb-1">{{ shipping_method.title }}</p>
  {% if not shipping_method.error %}
  {% for quote in shipping_method.quote %}
  <div class="radio">
    <label> {% if quote.code == code or not code %}
      {% set code = quote.code %}
      <input type="radio" name="shipping_method" value="{{ quote.code }}" checked="checked" />
      {% else %}
      <input type="radio" name="shipping_method" value="{{ quote.code }}" />
      {% endif %}
      {{ quote.title }} - {{ quote.text }}</label>
  </div>
  {% endfor %}
  {% else %}
  <div class="alert alert-danger alert-dismissible">{{ shipping_method.error }}</div>
  {% endif %}
  {% endfor %}
  {% endif %}
  <p class="font-headline font-bold text-sm text-ink mt-4 mb-2">{{ text_comments }}</p>
  <p>
    <textarea name="comment" rows="6" class="form-control">{{ comment }}</textarea>
  </p>
  <div class="buttons">
    <div class="pull-right">
      <input type="button" value="{{ button_continue }}" id="button-shipping-method" data-loading-text="{{ text_loading }}" class="btn btn-primary" />
    </div>
  </div>
</div>
